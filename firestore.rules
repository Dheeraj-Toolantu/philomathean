rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    match /results/{resultId} {
      allow read: if isAdmin() || (resource.data.published == true);
      allow create, update, delete: if isAdmin();
    }
    match /pastPaperResources/{paperId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /publicPastPapers/{paperId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /auditLogs/{logId} { allow read: if isAdmin(); allow write: if false; }

    // ---------- Student portal ----------
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function student(uid) { return get(/databases/$(database)/documents/students/$(uid)).data; }
    function isGold(uid) {
      let profile = student(uid);
      return profile.plan == 'gold' && (!('planExpiresAt' in profile) || profile.planExpiresAt == null || request.time < timestamp.value(profile.planExpiresAt));
    }
    function shortString(value, max) { return value is string && value.size() <= max; }
    function validProfileFields(data) {
      return shortString(data.get('displayName', ''), 80) && shortString(data.get('phone', ''), 20) && shortString(data.get('grade', ''), 40)
        && shortString(data.get('school', ''), 120) && shortString(data.get('curriculum', ''), 40) && shortString(data.get('targetSession', ''), 40)
        && shortString(data.get('bio', ''), 500) && shortString(data.get('parentEmail', ''), 120) && shortString(data.get('photoURL', ''), 1000)
        && shortString(data.get('shareId', ''), 32)
        && (data.get('planRequest', null) == null || (data.planRequest.plan == 'gold' && shortString(data.planRequest.note, 500)));
    }

    match /students/{uid} {
      // Teachers read student profiles to enter marks and follow each student's performance.
      allow read: if isOwner(uid) || isAdmin() || isTeacher();
      // New profiles always start on the free plan with the signed-in email. Accounts an administrator creates
      // (login ID + password) write this profile as the new student, so the same rule applies to them.
      allow create: if isOwner(uid) && request.resource.data.uid == uid && request.resource.data.plan == 'free'
        && request.resource.data.email == request.auth.token.get('email', '') && !('planExpiresAt' in request.resource.data)
        && validProfileFields(request.resource.data)
        && (!('loginId' in request.resource.data) || shortString(request.resource.data.loginId, 120));
      // Students edit their own details; plan, email and identity fields belong to administrators.
      allow update: if isAdmin() || (isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email', 'loginId', 'createdByAdmin', 'plan', 'planExpiresAt', 'createdAt'])
        && validProfileFields(request.resource.data));
      allow delete: if isAdmin();

      match /enrollments/{courseId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && request.resource.data.courseId == courseId && request.resource.data.keys().hasOnly(['courseId', 'tier', 'enrolledAt'])
          && (request.resource.data.tier == 'free' || (request.resource.data.tier == 'premium' && isGold(uid)));
        allow update: if false;
        allow delete: if isOwner(uid) || isAdmin();
      }

      // Attempts are append-only so scores cannot be edited after the fact.
      match /attempts/{attemptId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(['courseId', 'quizId', 'kind', 'title', 'mode', 'topicId', 'total', 'answered', 'correct', 'scorePct', 'durationSec', 'createdAt'])
          && request.resource.data.kind in ['topic', 'ladder', 'mock', 'prediction', 'custom'] && request.resource.data.mode in ['study', 'exam']
          && shortString(request.resource.data.courseId, 60) && shortString(request.resource.data.quizId, 300) && shortString(request.resource.data.title, 120)
          && request.resource.data.total is int && request.resource.data.total > 0 && request.resource.data.total <= 100
          && request.resource.data.answered is int && request.resource.data.answered >= 0 && request.resource.data.answered <= request.resource.data.total
          && request.resource.data.correct is int && request.resource.data.correct >= 0 && request.resource.data.correct <= request.resource.data.answered
          && request.resource.data.scorePct is int && request.resource.data.scorePct >= 0 && request.resource.data.scorePct <= 100
          && request.resource.data.durationSec is int && request.resource.data.durationSec >= 0
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Practice questions for every quiz and exam format. Students read them; only administrators edit.
    match /questionBanks/{bankId} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.questions is list && request.resource.data.questions.size() <= 500
        && request.resource.data.version is int;
      allow delete: if isAdmin();
    }

    // ---------- Teachers, test marks, schedule, teaching material, ratings ----------
    // A teacher is any account an administrator has added to /teachers (keyed by the account's uid).
    function isTeacher() { return request.auth != null && exists(/databases/$(database)/documents/teachers/$(request.auth.uid)); }
    function isStaff() { return isAdmin() || isTeacher(); }
    function isScore(value, max) { return value is number && value >= 0 && value <= max; }

    match /teachers/{uid} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() && request.resource.data.uid == uid && shortString(request.resource.data.name, 80)
        && shortString(request.resource.data.get('email', ''), 120) && shortString(request.resource.data.get('subjects', ''), 120) && request.resource.data.order is number;
      allow delete: if isAdmin();
    }

    // Marks are entered by teachers or administrators; each student can read only their own.
    // passMark is optional; remedial is the teacher's decision (never automatic) and remedialDone records the finished worksheet.
    match /testMarks/{markId} {
      allow read: if isStaff() || (request.auth != null && resource.data.studentUid == request.auth.uid);
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['testId', 'studentUid', 'studentName', 'subject', 'testTitle', 'testDate', 'score', 'maxScore', 'schoolScore', 'passMark', 'note', 'remedial', 'remedialWork', 'remedialDone', 'teacherUid', 'teacherName', 'createdAt', 'updatedAt'])
        && shortString(request.resource.data.testId, 64) && shortString(request.resource.data.studentUid, 128) && shortString(request.resource.data.studentName, 80)
        && shortString(request.resource.data.subject, 60) && shortString(request.resource.data.testTitle, 120) && request.resource.data.testDate is string && request.resource.data.testDate.size() == 10
        && isScore(request.resource.data.maxScore, 1000) && request.resource.data.maxScore > 0 && isScore(request.resource.data.score, request.resource.data.maxScore)
        && (request.resource.data.schoolScore == null || isScore(request.resource.data.schoolScore, 100))
        && (request.resource.data.get('passMark', null) == null || isScore(request.resource.data.passMark, request.resource.data.maxScore))
        && request.resource.data.get('remedial', false) is bool && request.resource.data.get('remedialDone', false) is bool
        && shortString(request.resource.data.get('remedialWork', ''), 300)
        && shortString(request.resource.data.note, 500) && request.resource.data.teacherUid == request.auth.uid && shortString(request.resource.data.teacherName, 80);
      allow delete: if isStaff();
    }

    // Each week's top 10 by average test %, published by staff whenever marks change (students can't read others' marks).
    match /leaderboards/{weekStart} {
      allow read: if request.auth != null;
      allow create, update: if isStaff() && request.resource.data.keys().hasOnly(['weekStart', 'weekEnd', 'participants', 'entries', 'updatedAt'])
        && request.resource.data.weekStart == weekStart && weekStart.size() == 10 && request.resource.data.weekEnd is string && request.resource.data.weekEnd.size() == 10
        && request.resource.data.participants is int && request.resource.data.entries is list && request.resource.data.entries.size() <= 10;
      allow delete: if isStaff();
    }

    // Teachers who sign up at /login ask for teacher access here; an administrator approves (adds /teachers/{uid}) or declines.
    match /teacherRequests/{uid} {
      allow get: if isAdmin() || isOwner(uid);
      allow list: if isAdmin();
      allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'phone', 'subjects', 'message', 'status', 'createdAt'])
        && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.get('email', '')
        && shortString(request.resource.data.name, 80) && request.resource.data.name.size() > 0 && shortString(request.resource.data.phone, 20)
        && shortString(request.resource.data.subjects, 120) && shortString(request.resource.data.message, 500)
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && request.resource.data.status in ['pending', 'declined'];
      allow delete: if isAdmin() || isOwner(uid);
    }

    // Daily practice streaks for the streak wall. Each student publishes their own; any signed-in user can read them.
    match /streaks/{uid} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(uid) && request.resource.data.keys().hasOnly(['uid', 'name', 'current', 'best', 'lastDay', 'updatedAt'])
        && request.resource.data.uid == uid && shortString(request.resource.data.name, 40)
        && request.resource.data.current is int && request.resource.data.current >= 0 && request.resource.data.current <= 3660
        && request.resource.data.best is int && request.resource.data.best >= request.resource.data.current && request.resource.data.best <= 3660
        && request.resource.data.lastDay is string && request.resource.data.lastDay.size() <= 10 && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /testSchedule/{testId} {
      allow read: if request.auth != null;
      allow create, update: if isStaff() && shortString(request.resource.data.title, 120) && shortString(request.resource.data.subject, 60)
        && shortString(request.resource.data.batch, 80) && request.resource.data.date is string && request.resource.data.date.size() == 10
        && shortString(request.resource.data.time, 5) && isScore(request.resource.data.maxScore, 1000) && shortString(request.resource.data.notes, 500)
        && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if isStaff();
    }

    match /teachingMaterials/{materialId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() && shortString(request.resource.data.title, 120) && shortString(request.resource.data.url, 1000) && shortString(request.resource.data.description, 1000);
      allow delete: if isAdmin();
    }

    // Students rate teachers 1–5 (one rating per teacher, which they can change). Teachers see only ratings of themselves.
    match /teacherRatings/{ratingId} {
      allow read: if isAdmin() || (request.auth != null && (resource.data.studentUid == request.auth.uid || resource.data.teacherUid == request.auth.uid));
      allow create, update: if request.auth != null && request.resource.data.studentUid == request.auth.uid
        && ratingId == request.auth.uid + '_' + request.resource.data.teacherUid
        && exists(/databases/$(database)/documents/teachers/$(request.resource.data.teacherUid))
        && request.resource.data.keys().hasOnly(['studentUid', 'teacherUid', 'teacherName', 'rating', 'comment', 'updatedAt'])
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && shortString(request.resource.data.comment, 500) && shortString(request.resource.data.teacherName, 80)
        && (resource == null || resource.data.studentUid == request.auth.uid);
      allow delete: if isAdmin() || (request.auth != null && resource.data.studentUid == request.auth.uid);
    }

    // Public, read-only progress cards. Only the owner can publish, refresh or remove theirs.
    match /progressShares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
