rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    // Members are students on an active Gold plan. planExpiresAt is an ISO date string ("2027-11-09T…Z"), so it is
    // compared with today's date written the same way; the plan stays active until the end of its expiry day.
    function twoDigits(n) { return n < 10 ? '0' + string(n) : string(n); }
    function today() { return string(request.time.year()) + '-' + twoDigits(request.time.month()) + '-' + twoDigits(request.time.day()); }
    function studentPath() { return /databases/(default)/documents/students/$(request.auth.uid); }
    function isMember() {
      return request.auth != null && firestore.exists(studentPath())
        && firestore.get(studentPath()).data.get('plan', 'free') == 'gold'
        && (firestore.get(studentPath()).data.get('planExpiresAt', null) == null || firestore.get(studentPath()).data.planExpiresAt >= today());
    }
    // Free PDFs are open to everyone; premium PDFs (such as solved papers) only to members.
    match /past-papers/{resourceId}/{fileName} {
      allow read: if isAdmin() || (resource.metadata.published == 'true'
        && (resource.metadata.access == 'free' || (resource.metadata.access == 'premium' && isMember())));
      allow create: if isAdmin() && request.resource.contentType == 'application/pdf' && request.resource.size <= 25 * 1024 * 1024;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    // Diagrams attached to practice questions (admin panel → Questions).
    match /question-images/{bankId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size <= 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
    // Student profile photos (resized to a small JPEG in the browser before upload).
    match /student-photos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.size <= 2 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
  }
}
