rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    match /past-papers/{resourceId}/{fileName} {
      allow read: if isAdmin() || (resource.metadata.published == 'true' && resource.metadata.access == 'free');
      allow create: if isAdmin() && request.resource.contentType == 'application/pdf' && request.resource.size <= 25 * 1024 * 1024;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    // Student profile photos (resized to a small JPEG in the browser before upload).
    match /student-photos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.size <= 2 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
  }
}
